# Copy to .env for local development — never commit .env.
APP_ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# New Supabase projects: leave this empty and use the project's JWKS endpoint.
SUPABASE_JWKS_URL=
# Legacy HS256 projects only: set this server-side and leave SUPABASE_JWKS_URL empty.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
DOCS_ENABLED=true
# Session pooler, port 5432: postgresql+psycopg://mill_runtime.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres
RUNTIME_DATABASE_URL=
OPENROUTER_API_KEY=
# Migration/admin URL belongs only in the migration shell or CI secret, never in the web service.
